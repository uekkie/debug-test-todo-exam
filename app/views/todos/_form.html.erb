<%= form_with model: todo do |f| %>
  <% if todo.errors.any? %>
    <ul class="errors">
      <% todo.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  <p><%= f.label :title, "タイトル" %><br><%= f.text_field :title %></p>
  <p><%= f.label :category_id, "カテゴリ" %><br><%= f.collection_select :category_id, Category.order(:id), :id, :name, include_blank: "なし" %></p>
  <p><%= f.label :due_on, "締切" %><br><%= f.date_field :due_on %></p>
  <p><%= f.label :memo, "メモ" %><br><%= f.text_area :memo, rows: 4 %></p>
  <%= f.hidden_field :done, value: todo.done? %>
  <p><%= f.submit "保存" %></p>
<% end %>
