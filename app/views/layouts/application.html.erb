<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "TODO" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header>
      <%= link_to "TODO", root_path, class: "brand" %>
      <% if current_user %>
        <span><%= current_user.name %> さん</span>
        <%= button_to "ログアウト", logout_path, method: :delete, class: "link" %>
      <% end %>
    </header>
    <main>
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
